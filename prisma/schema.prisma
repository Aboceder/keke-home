generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 时间均存北京时间的墙上时间字符串 "YYYY-MM-DD HH:mm" 或 "YYYY-MM-DD"
// 时长一律存秒

model Feeding {
  id           Int      @id @default(autoincrement())
  startedAt    String // 开始时间 "YYYY-MM-DD HH:mm"
  leftSeconds  Int? // 左侧时长（秒）
  rightSeconds Int? // 右侧时长（秒）
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Bottle {
  id        Int      @id @default(autoincrement())
  time      String // 喂奶时间 "YYYY-MM-DD HH:mm"
  amountMl  Int // 奶量（毫升）
  type      String   @default("奶粉") // 奶粉 / 母乳
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Stool {
  id           Int      @id @default(autoincrement())
  time         String // 排便时间 "YYYY-MM-DD HH:mm"
  texture      String? // 稀/软/成形/干硬/其他
  textureOther String? // 性状为"其他"时的补充说明
  color        String? // 黄/黄褐/绿/棕/黑/其他
  colorOther   String? // 颜色为"其他"时的补充说明
  note         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 全局唯一的一条进行中母乳记录，id 恒为 1
model ActiveFeeding {
  id                   Int      @id @default(1)
  version              String? // 每次状态变化生成新版本；允许旧计时记录迁移后暂为 null
  startedAt            String // 本次喂奶开始时间 "YYYY-MM-DD HH:mm"
  activeSide           String? // 正在计时的侧：left/right；null 表示已结束一侧、等待切换或结束
  activeSideStartedAt  DateTime? // 当前侧开始计时的真实时刻（算经过秒数用）
  leftSeconds          Int? // 已结束的左侧时长（秒）
  rightSeconds         Int? // 已结束的右侧时长（秒）
  leftDone             Boolean  @default(false)
  rightDone            Boolean  @default(false)
}

// 睡眠：一段「入睡 → 醒来」的区间；跨天的时段在统计时按重叠拆分，时间线按 startedAt 归档
model Sleep {
  id        Int      @id @default(autoincrement())
  startedAt String // 入睡时间 "YYYY-MM-DD HH:mm"
  endedAt   String // 醒来时间 "YYYY-MM-DD HH:mm"
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startedAt])
  @@index([endedAt])
}

// 全局唯一的一条进行中睡眠，id 恒为 1
model ActiveSleep {
  id          Int      @id @default(1)
  version     String? // 每次状态变化生成新版本；与 ActiveFeeding 同一套乐观锁
  startedAt   String // 入睡时间 "YYYY-MM-DD HH:mm"（写进 Sleep 用）
  startedAtMs DateTime // 入睡的真实时刻（算经过秒数用）
}
